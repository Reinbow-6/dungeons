# ==========================================
# Base de datos Supabase Postgres (Drizzle)
# ==========================================
# Pooler Transaction Mode (puerto 6543) para runtime serverless / Next.js
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# Conexión directa (puerto 5432) recomendada para migraciones con drizzle-kit
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ==========================================
# Proveedores LLM habilitados (OpenRouter Free + Groq)
# ==========================================
# Proveedor por defecto: OpenRouter con router gratuito que filtra tool calling
LLM_PROVIDER="openrouter"
LLM_MODEL="openrouter/free"
OPENROUTER_API_KEY=""

# Groq: Qwen 3.8 27B + respaldo activo GPT-OSS 120B (llama-3.3-70b-versatile fue retirado por Groq)
# LLM_PROVIDER="groq"
# LLM_MODEL="qwen/qwen3.8-27b"
# LLM_MODEL="openai/gpt-oss-120b"
GROQ_API_KEY=""

# Opcional futuro (por ahora se usa un único modelo):
# MECHANICS_MODEL="openrouter/free"
# NARRATIVE_MODEL="qwen/qwen3.8-27b"

# ==========================================
# Sesión anónima y Guardrails
# ==========================================
# En producción es obligatorio definir una clave de al menos 16 caracteres
SESSION_SECRET=""
RATE_LIMIT_RPM="20"
DAILY_REQUEST_CAP_PER_GUEST="100"
DAILY_TOKEN_CAP_PER_GUEST="200000"
DAILY_SPEND_CAP_USD="1.0"
MAX_AGENT_STEPS="5"
MAX_OUTPUT_TOKENS="2048"

# ==========================================
# Supabase Auth y Whitelist (Modo Invitado Limitado)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Lista de emails habilitados (separados por coma, punto y coma o salto de línea)
AUTH_WHITELIST_EMAILS=""
