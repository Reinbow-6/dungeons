# ==========================================
# Base de datos Supabase Postgres (Drizzle)
# ==========================================
# Pooler Transaction Mode (puerto 6543) para runtime serverless / Next.js
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# Conexión directa opcional para migraciones con drizzle-kit (si se omite usa DATABASE_URL)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ==========================================
# Proveedores LLM, STT y TTS
# ==========================================
# OpenRouter: openrouter/free por defecto (DeepSeek V4.1 Flash requiere whitelist) y entrada de /api/tts
LLM_PROVIDER="openrouter"
LLM_MODEL="openrouter/free"
OPENROUTER_API_KEY=""

# Groq: requerido para dictado por voz STT (/api/stt con Whisper) y smoke:providers
GROQ_API_KEY=""

# Opcional: Fish Audio directo para TTS (requiere igualmente OPENROUTER_API_KEY configurada)
FISH_API_KEY=""

# ==========================================
# Sesión anónima, Ventana de Contexto y Guardrails
# ==========================================
# En producción es obligatorio definir una clave de al menos 16 caracteres
SESSION_SECRET=""
RATE_LIMIT_RPM="20"
DAILY_REQUEST_CAP_PER_GUEST="100"
DAILY_TOKEN_CAP_PER_GUEST="200000"
DAILY_SPEND_CAP_USD="1.0"
# Valores recomendados de ejemplo (defaults en código: 1.0 USD/1M, msgs: 10, chars: 12000)
ESTIMATED_COST_PER_1M_TOKENS_USD="0.5"
MAX_AGENT_STEPS="5"
MAX_OUTPUT_TOKENS="2048"
MAX_CONTEXT_MESSAGES="16"
MAX_CONTEXT_CHARS="24000"

# ==========================================
# Supabase Auth y Whitelist (Modo Invitado Limitado)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Lista de emails habilitados (separados por coma, punto y coma o salto de línea)
AUTH_WHITELIST_EMAILS=""
