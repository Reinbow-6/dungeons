{
  "name": "@dungeons/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "predev": "pnpm --filter @dungeons/rules build && pnpm --filter @dungeons/srd build",
    "dev": "next dev",
    "prebuild": "pnpm --filter @dungeons/rules build && pnpm --filter @dungeons/srd build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "smoke:providers": "node scripts/smoke-providers.mjs",
    "smoke:stt": "node scripts/smoke-stt.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/gateway": "^4.0.96",
    "@ai-sdk/google": "^4.0.122",
    "@ai-sdk/groq": "^4.0.85",
    "@ai-sdk/openai": "^4.0.78",
    "@ai-sdk/react": "^4.0.121",
    "@base-ui/react": "^1.8.0",
    "@dungeons/rules": "workspace:*",
    "@dungeons/srd": "workspace:*",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@shadcn/react": "^0.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "ai": "^7.0.118",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.1.1"
